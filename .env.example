# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env al repositorio.

# --- PostgreSQL (usado por docker-compose) ---
POSTGRES_USER=tjt
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tjt

# --- Worker ---
# Cuando corres el worker FUERA de Docker (npm run dev), apunta a localhost.
# Dentro de docker-compose esta variable la define el propio compose.
DATABASE_URL=postgres://tjt:cambia_esta_clave@localhost:5432/tjt

# Fuentes a consultar, separadas por comas: remotive, arbeitnow, hn
SOURCES=remotive,arbeitnow,hn

# Remotive: categoría a consultar (ojo: el filtro de la API no es estricto; la relevancia se calcula aparte en is_tech)
REMOTIVE_CATEGORY=software-dev

# Arbeitnow: máximo de páginas a recorrer en cada ejecución (1 a 20). Hay una pausa entre páginas.
ARBEITNOW_MAX_PAGES=5

# Hacker News "Who is hiring?": cuántos hilos mensuales recorrer (1 a 12). Con 1 solo se lee el más reciente;
# subirlo (p. ej. 6) carga histórico de meses anteriores, útil para ver tendencias desde el primer día.
HN_THREADS=1

# Cada cuántas horas corre el ETL. Remotive recomienda máximo 4 peticiones al día,
# por eso el mínimo permitido es 6 horas (se aplica a todas las fuentes).
ETL_INTERVAL_HOURS=6

# true = ejecuta una sola vez y termina (útil para pruebas manuales)
RUN_ONCE=false

# true = ignora la guarda de "no consultar si ya corrió hace poco". Úsalo con cuidado.
FORCE_RUN=false

LOG_LEVEL=info

# --- API REST ---
# Puerto en tu equipo donde se publica la API (solo en 127.0.0.1). Documentación en http://localhost:3000/api/docs
API_PORT=3000

# Puerto en tu equipo donde se publica el dashboard (solo en 127.0.0.1): http://localhost:8080
WEB_PORT=8080

# Orígenes que pueden llamar a la API desde un navegador, separados por comas. El dashboard NO lo necesita
# (nginx y el proxy de desarrollo de Vite le dan el mismo origen); solo importa si otra web llama a la API directamente.
CORS_ORIGIN=http://localhost:5173

# Peticiones por minuto y por IP (0 = sin límite).
RATE_LIMIT_PER_MIN=120

# Segundos que los clientes pueden cachear las respuestas (los datos cambian como mucho cada pocas horas).
CACHE_SECONDS=60

# --- Despliegue en un servidor (docker-compose.prod.yml + Caddy) ---
# Dominio que apunta a la IP del servidor (p. ej. un subdominio gratis de DuckDNS) y correo para avisos de Let's Encrypt.
# DOMAIN=mi-tracker.duckdns.org
# ACME_EMAIL=tu@correo.com
# Para usar solo `docker compose up -d --build` en el servidor:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
